---
import type { Project } from '../data/projects';

interface Props {
	project: Project;
}

const { project } = Astro.props;
---

<div class="card project-card">
	<div class="card-header">
		<div class="title-wrap">
			<h3 class="project-title">{project.title}</h3>
			{project.badge && <span class="badge status-badge">{project.badge}</span>}
		</div>
		<div class="project-links">
			{project.github && (
				<a href={project.github} target="_blank" rel="noopener noreferrer" class="link-icon" title="查看源码" aria-label="GitHub 源码">
					<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
					</svg>
				</a>
			)}
			{project.link && (
				<a href={project.link} target={project.link.startsWith('http') ? "_blank" : "_self"} rel="noopener noreferrer" class="link-icon" title="访问项目" aria-label="访问项目">
					<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
						<polyline points="15 3 21 3 21 9"></polyline>
						<line x1="10" y1="14" x2="21" y2="3"></line>
					</svg>
				</a>
			)}
		</div>
	</div>

	<p class="project-desc">{project.description}</p>

	<div class="project-tags">
		{project.tags.map((tag) => (
			<span class="badge tag">{tag}</span>
		))}
	</div>
</div>

<style>
	.project-card {
		display: flex;
		flex-direction: column;
		height: 100%;
	}

	.card-header {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		gap: 0.75rem;
		margin-bottom: 0.75rem;
	}

	.title-wrap {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.project-title {
		font-size: 1.15rem;
		margin: 0;
		color: var(--text-primary);
	}

	.status-badge {
		background-color: var(--accent-subtle);
		color: var(--accent);
		border-color: var(--accent);
		font-size: 0.75rem;
		padding: 0.15rem 0.5rem;
	}

	.project-links {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.link-icon {
		color: var(--text-muted);
		padding: 0.25rem;
		border-radius: var(--radius-sm);
		display: flex;
		align-items: center;
		transition: color 0.15s;
	}

	.link-icon:hover {
		color: var(--accent);
	}

	.project-desc {
		font-size: 0.92rem;
		color: var(--text-secondary);
		line-height: 1.6;
		margin-bottom: 1.25rem;
		flex-grow: 1;
	}

	.project-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}

	.tag {
		font-size: 0.75rem;
		padding: 0.2rem 0.5rem;
	}
</style>
